# PostgreSQL connection string.
# Example (local):     postgresql://postgres:password@localhost:5432/splitwise
# Example (Neon/Supabase/Railway): use the connection string they provide.
DATABASE_URL=

# Secret used to sign JWTs. Generate a strong random value for production,
# e.g.: openssl rand -base64 48
JWT_SECRET=

# How long issued JWTs remain valid.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=5000

# The frontend origin allowed by CORS (no trailing slash).
CLIENT_URL=http://localhost:5173

# development | production | test
NODE_ENV=development
